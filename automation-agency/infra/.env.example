# Copy to .env and fill in. NEVER commit the real .env.
# Generate every secret with: openssl rand -base64 36

# --- hostnames -------------------------------------------------------------
N8N_HOST=flows.youragency.co.za
PORTAL_HOST=portal.youragency.co.za

# --- PostgreSQL 18 ---------------------------------------------------------
PG_DB=agency
PG_SUPERUSER=agency_admin
PG_SUPERUSER_PASSWORD=

# Least-privilege roles created by db/001_core.sql
APP_DB_USER=agency_app
APP_DB_PASSWORD=
PORTAL_DB_USER=agency_portal_ro
PORTAL_DB_PASSWORD=

N8N_DB_NAME=agency
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=

METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=

# --- n8n -------------------------------------------------------------------
# Losing this key makes every stored credential unrecoverable. Escrow it.
N8N_ENCRYPTION_KEY=

# --- redis -----------------------------------------------------------------
REDIS_PASSWORD=

# --- internal services -----------------------------------------------------
GATEWAY_API_KEY=
PORTAL_AUTH_SECRET=

# --- WhatsApp Business Platform (Meta Cloud API) ---------------------------
# Per-tenant phone numbers and tokens live in agency.integration, encrypted.
# Only the app-level secret used for webhook signature verification is here.
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- off-site backups (S3-compatible; keep a copy in-country) --------------
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_REGION=
BACKUP_KEY=
BACKUP_SECRET=
BACKUP_CIPHER_PASS=
